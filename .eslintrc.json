{
  "env": {
    "browser": true,
    "es2021": true,
    "node": true
  },
  "extends": [
    "eslint:recommended"
  ],
  "parserOptions": {
    "ecmaFeatures": {
      "jsx": true
    },
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    // Общие правила форматирования
    "no-unused-vars": "warn",
    "no-console": "warn",
    "no-multiple-empty-lines": [
      "error",
      {
        "max": 0
      }
    ], // Запрет пустых строк
    "eol-last": [
      "error",
      "always"
    ], // Пустая строка в конце файла
    // Правила для JSX (встроенные, без плагинов)
    "react/jsx-uses-react": "off",
    "react/jsx-uses-vars": "warn"
  }
}
